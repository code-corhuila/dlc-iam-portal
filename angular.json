{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "dlc-iam-portal": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "dlc",
      "architect": {
        "build": {
          "builder": "@angular-architects/native-federation:build",
          "options": {
            "target": "dlc-iam-portal:build-original:production"
          },
          "configurations": {
            "production": {
              "target": "dlc-iam-portal:build-original:production"
            },
            "development": {
              "target": "dlc-iam-portal:build-original:development",
              "dev": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-architects/native-federation:build",
          "options": {
            "target": "dlc-iam-portal:serve-original:development",
            "dev": true
          }
        },
        "build-original": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/dlc-iam-portal",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": []
          },
          "configurations": {
            "production": {
              "browser": "src/main.production.ts",
              "index": {
                "input": "src/index.production.html",
                "output": "index.html"
              },
              "assets": [],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "sourceMap": true,
              "styles": [
                "src/preview.css"
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve-original": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "dlc-iam-portal:build-original:development",
            "port": 4201
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "dlc-iam-portal:build-original:development",
            "tsConfig": "tsconfig.spec.json",
            "runner": "vitest"
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
